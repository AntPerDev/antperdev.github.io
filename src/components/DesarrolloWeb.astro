<style>
  /* =========================================================
     VARIABLES
     ========================================================= */

  .dev-hero {
    --bg: #020b18;
    --bg-soft: #061529;
    --blue: #00a8ff;
    --blue-light: #26c6ff;
    --purple: #8b35ff;
    --text: #f4f7fb;
    --muted: #a9b5c7;
    --border: rgba(55, 133, 255, 0.2);

    position: relative;
    overflow: hidden;

    color: var(--text);
    background:
      radial-gradient(
        circle at 80% 35%,
        rgba(0, 121, 255, 0.13),
        transparent 27rem
      ),
      radial-gradient(
        circle at 10% 90%,
        rgba(35, 38, 255, 0.18),
        transparent 24rem
      ),
      var(--bg);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .dev-hero__container {
    width: min(100% - 2rem, 1180px);
    margin-inline: auto;
    padding-block: 3rem;
  }

  /* =========================================================
     INTRO
     ========================================================= */

  .dev-intro {
    max-width: 620px;
  }

  .dev-intro__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;

    margin-bottom: 0.8rem;

    color: var(--purple);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .dev-intro__code {
    color: #7047ff;
    font-size: 2.4rem;
    line-height: 0.7;
    font-weight: 500;
  }

  .dev-intro h1 {
    margin: 0;

    font-size: clamp(2.4rem, 9vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .dev-intro h1 span {
    display: block;

    background: linear-gradient(90deg, #9b36ff 0%, #735cff 35%, #00c8ff 100%);

    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .dev-intro__line {
    width: 75px;
    height: 2px;
    margin-block: 1rem;

    background: linear-gradient(90deg, var(--blue), transparent);
  }

  .dev-intro p {
    max-width: 410px;
    margin: 0;

    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .dev-intro p strong {
    color: var(--blue-light);
  }

  /* =========================================================
     TITULOS DE SECCION
     ========================================================= */

  .section-heading {
    display: flex;
    align-items: center;
    gap: 0.65rem;

    margin-bottom: 1.25rem;
  }

  .section-heading span {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .section-heading h2 {
    margin: 0;

    color: var(--blue-light);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  /* =========================================================
     WORKFLOW
     ========================================================= */

  .workflow {
    margin-top: 3rem;
  }

  .workflow__steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .workflow-step {
    position: relative;

    display: grid;
    grid-template-columns: 58px 1fr;
    column-gap: 1rem;

    align-items: center;

    padding: 0.5rem;
  }

  .workflow-step__icon {
    grid-row: span 2;

    display: grid;
    place-items: center;

    width: 58px;
    aspect-ratio: 1;

    border-radius: 12px;

    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.25);
  }

  .workflow-step__icon--chat {
    color: white;
    background: linear-gradient(145deg, #8b4dff, #4135dd);
    font-size: 1.2rem;
    letter-spacing: 0.1em;
  }

  .workflow-step__icon--design {
    background: linear-gradient(145deg, #e8edf4, #9ca8ba);
  }

  .browser-icon {
    position: relative;

    width: 35px;
    height: 28px;

    border: 2px solid #566275;
    border-radius: 4px;
    background: #dce2ea;
  }

  .browser-icon::before {
    content: "";

    position: absolute;
    inset: 5px 3px auto;

    height: 2px;

    background: #778397;
  }

  .dev-hero .workflow-step__icon--code {
    color: #1b6eff;
    background: linear-gradient(145deg, #152c4e, #071426);
    font-size: 1.5rem;
    font-family: monospace;
  }

  .workflow-step__icon--deploy {
    color: white;
    background: linear-gradient(145deg, #5e63ff, #188bff);
    font-size: 2rem;
  }

  .workflow-step__arrow {
    display: none;
  }

  .workflow-step h3 {
    margin: 0;

    color: #e6ebf4;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .workflow-step p {
    margin: 0.25rem 0 0;

    color: var(--muted);
    font-size: 0.65rem;
    line-height: 1.45;
  }

  /* =========================================================
     DEVICES
     ========================================================= */

  .devices {
    position: relative;

    min-height: 310px;
    margin: 3rem auto 0;

    display: grid;
    place-items: center;
  }

  .laptop {
    position: relative;

    width: min(90%, 470px);
    transform: rotate(-2deg);
  }

  .laptop__screen {
    position: relative;

    aspect-ratio: 16 / 10;

    padding: 8px;

    border: 1px solid #697a91;
    border-radius: 12px 12px 5px 5px;

    background: #07111f;

    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
  }

  .browser-bar {
    display: flex;
    gap: 4px;

    height: 10px;
    padding-inline: 5px;
  }

  .browser-bar i {
    width: 4px;
    height: 4px;

    border-radius: 50%;
    background: #58667a;
  }

  .laptop__content {
    display: grid;
    grid-template-columns: 28% 1fr;

    height: calc(100% - 10px);

    overflow: hidden;

    border-radius: 5px;

    background:
      radial-gradient(
        circle at 70% 50%,
        rgba(0, 102, 255, 0.35),
        transparent 50%
      ),
      #07152a;
  }

  .code-lines {
    display: flex;
    flex-direction: column;
    gap: 7px;

    padding: 15px 10px;

    background: rgba(0, 0, 0, 0.18);
  }

  .code-lines span {
    width: 70%;
    height: 2px;

    border-radius: 2px;

    background: #3178ff;
    opacity: 0.7;
  }

  .code-lines span:nth-child(2) {
    width: 45%;
  }

  .code-lines span:nth-child(3) {
    width: 85%;
  }

  .code-lines span:nth-child(5) {
    width: 55%;
  }

  .website-preview {
    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 1rem;
  }

  .website-preview small {
    color: #a8b7ce;
    font-size: 0.35rem;
  }

  .website-preview strong {
    margin-block: 0.25rem;

    font-size: clamp(0.7rem, 2vw, 1.1rem);
    line-height: 1.1;
  }

  .website-preview em {
    margin-bottom: 0.6rem;

    color: #9daec8;
    font-size: 0.35rem;
    font-style: normal;
  }

  .website-preview button,
  .phone button {
    align-self: flex-start;

    border: 0;
    border-radius: 999px;

    padding: 0.3rem 0.55rem;

    color: white;
    background: #087cff;

    font-size: 0.35rem;
  }

  .laptop__base {
    width: 110%;
    height: 10px;

    margin-left: -5%;

    border-radius: 0 0 12px 12px;

    background: linear-gradient(180deg, #67778a, #172536);

    clip-path: polygon(3% 0, 97% 0, 100% 100%, 0 100%);
  }

  .phone {
    position: absolute;

    right: 2%;
    bottom: 10px;

    width: 80px;
    aspect-ratio: 0.48;

    padding: 7px;

    border: 2px solid #222e3d;
    border-radius: 13px;

    background: #101a28;

    transform: rotate(5deg);

    box-shadow: 0 20px 35px rgba(0, 0, 0, 0.5);
  }

  .phone__speaker {
    width: 22px;
    height: 3px;

    margin: 1px auto 4px;

    border-radius: 99px;

    background: #354153;
  }

  .phone__screen {
    display: flex;
    flex-direction: column;
    justify-content: center;

    height: calc(100% - 8px);

    padding: 0.45rem;

    border-radius: 7px;

    background:
      radial-gradient(
        circle at 50% 40%,
        rgba(0, 112, 255, 0.4),
        transparent 60%
      ),
      #061426;
  }

  .phone__screen small {
    color: #9db1cb;
    font-size: 0.3rem;
  }

  .phone__screen strong {
    margin-block: 0.25rem;

    font-size: 0.5rem;
    line-height: 1.15;
  }

  .phone button {
    font-size: 0.25rem;
  }

  .coffee {
    position: absolute;

    left: 3%;
    bottom: 30px;

    display: grid;
    place-items: center;

    width: 55px;
    height: 45px;

    border-radius: 4px 4px 12px 12px;

    color: #546579;
    background: #17283b;

    box-shadow: 0 15px 25px rgba(0, 0, 0, 0.35);
  }

  .coffee span {
    font-family: monospace;
    font-size: 0.75rem;
  }

  /* =========================================================
     SERVICIOS
     ========================================================= */

  .services {
    margin-top: 1rem;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    border: 1px solid var(--border);
    border-radius: 10px;

    overflow: hidden;
  }

  .service {
    min-height: 125px;

    padding: 1rem;

    text-align: center;

    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .service:nth-child(even) {
    border-right: 0;
  }

  .service:last-child {
    grid-column: span 2;

    border-right: 0;
    border-bottom: 0;
  }

  .service__icon {
    margin-bottom: 0.45rem;

    color: #258eff;

    font-family: monospace;
    font-size: 1.2rem;
  }

  .service h3 {
    margin: 0;

    color: #e5ebf4;
    font-size: 0.65rem;
  }

  .service p {
    margin: 0.35rem 0 0;

    color: #8796aa;
    font-size: 0.55rem;
    line-height: 1.4;
  }

  /* =========================================================
     TECNOLOGIAS
     ========================================================= */

  .technologies {
    margin-top: 2.5rem;
  }

  .technologies__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .technology {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;

    color: #aebbd0;
    font-size: 0.65rem;
  }

  .technology__logo {
    display: grid;
    place-items: center;

    width: 28px;
    height: 28px;

    font-size: 0.8rem;
    font-weight: 800;
  }

  .technology__logo--java {
    color: #ed6334;
  }

  .technology__logo--html {
    color: #ff6934;
  }

  .technology__logo--css {
    color: #258bff;
  }

  .technology__logo--js {
    color: #f7d83e;
  }

  .technology__logo--ts {
    color: #4b91d5;
  }

  .technology__logo--angular {
    color: #e52850;
  }

  .technology__logo--next {
    color: #fff;
  }

  .technology__logo--react {
    color: #31c8ff;
  }

  .technology__logo--node {
    color: #75b74b;
  }

  .technology__logo--mysql {
    color: #e0a43a;
    font-size: 0.55rem;
  }

  /* =========================================================
     TABLET
     ========================================================= */

  @media (min-width: 600px) {
    .dev-hero__container {
      width: min(100% - 3rem, 1050px);
      padding-block: 4rem;
    }

    .workflow__steps {
      grid-template-columns: repeat(2, 1fr);
    }

    .workflow-step {
      grid-template-columns: 58px 1fr;
    }

    .devices {
      min-height: 380px;
    }

    .phone {
      right: 10%;
    }

    .services__grid {
      grid-template-columns: repeat(5, 1fr);
    }

    .service {
      border-bottom: 0;
      border-right: 1px solid var(--border);
    }

    .service:nth-child(even) {
      border-right: 1px solid var(--border);
    }

    .service:last-child {
      grid-column: auto;
      border-right: 0;
    }

    .technologies__list {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  /* =========================================================
     DESKTOP
     ========================================================= */

  @media (min-width: 900px) {
    .dev-hero__container {
      display: grid;

      grid-template-columns:
        minmax(250px, 0.8fr)
        minmax(430px, 1.45fr)
        minmax(250px, 0.8fr);

      grid-template-areas:
        "intro workflow devices"
        "intro services services"
        "technologies technologies technologies";

      column-gap: 2rem;
      row-gap: 1.25rem;

      align-items: start;

      width: min(100% - 4rem, 1180px);
      padding-block: 2rem;
    }

    .dev-intro {
      grid-area: intro;

      padding-top: 1rem;
    }

    .workflow {
      grid-area: workflow;

      margin-top: 0;
    }

    .workflow__steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
    }

    .workflow-step {
      display: block;
      padding: 0;

      text-align: center;
    }

    .workflow-step__icon {
      width: 48px;
      margin-inline: auto;
      margin-bottom: 0.7rem;
    }

    .workflow-step__arrow {

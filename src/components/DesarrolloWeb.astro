      color: #718198;
      font-size: 1rem;
    }

    .workflow-step:last-child .workflow-step__arrow {
      display: none;
    }

    .workflow-step h3 {
      font-size: 0.55rem;
    }

    .workflow-step p {
      font-size: 0.5rem;
    }

    .devices {
      grid-area: devices;

      min-height: 220px;
      margin: 0;

      align-self: center;
    }

    .laptop {
      width: 100%;
    }

    .phone {
      width: 65px;
      right: -5px;
      bottom: 0;
    }

    .coffee {
      width: 45px;
      height: 38px;

      left: -5px;
      bottom: 0;
    }

    .services {
      grid-area: services;

      margin-top: 0;
    }

    .technologies {
      grid-area: technologies;

      margin-top: 0.5rem;
    }

    .technologies__list {
      grid-template-columns: repeat(10, 1fr);
    }
  }

  /* =========================================================
     LARGE DESKTOP
     ========================================================= */

  @media (min-width: 1100px) {
    .dev-intro h1 {
      font-size: 3.7rem;
    }

    .workflow__steps {
      gap: 1rem;
    }

    .workflow-step__arrow {
      right: -15px;
    }

    .devices {
      min-height: 245px;
    }
  }

  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {

---
---
<header class="header" id="site-header">
  <!-- Línea de progreso de scroll en la parte inferior del header -->
  <div class="scroll-progress" id="scroll-progress-bar" aria-hidden="true"></div>

  <div class="header-container">
    <a href="/" class="logo" id="header-logo" aria-label="Ir al inicio de antperdev">
      <span class="logo-bracket">&lt;</span>
      <span class="logo-name">antperdev</span>
      <span class="logo-bracket"> /&gt;</span>
    </a>
    
    <nav class="nav" aria-label="Navegación principal">
      <a href="/" class="nav-link" id="nav-inicio">Inicio</a>
      <a href="/#proyectos" class="nav-link" id="nav-proyectos">Proyectos</a>
      <a href="https://antperdev.github.io/cv" class="nav-link" id="nav-proyectos">Curriculum Vitae</a>
      <a href="/blog" class="nav-link" id="nav-blog">Blog</a>
      <a 
        href="https://github.com/antperdev" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="nav-link nav-github"
        id="nav-github"
        aria-label="Perfil de GitHub (abre en nueva pestaña)"
      >
        <!-- Icono GitHub SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="github-icon" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        GitHub
      </a>
    </nav>
  </div>
</header>

<script>
  // Barra de progreso de scroll: % de la página desplazada
  const progressBar = document.getElementById('scroll-progress-bar');
  if (progressBar) {
    const updateProgress = () => {
      const scrolled = window.scrollY;
      const total = document.documentElement.scrollHeight - window.innerHeight;
      const pct = total > 0 ? (scrolled / total) * 100 : 0;
      progressBar.style.setProperty('--progress', `${pct}%`);
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }

  // Header con fondo más opaco tras hacer scroll
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > 20);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 200;
    width: 100%;
    /* Glassmorphism base */
    background: rgba(8, 8, 16, 0.6);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid rgba(255, 107, 0, 0.12);
    height: 68px;
    display: flex;
    align-items: center;
    /* Brillo difuso superior */
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04),
                0 4px 30px rgba(0, 0, 0, 0.4);
    transition: background var(--transition), box-shadow var(--transition);
  }

  .header.scrolled {
    background: rgba(8, 8, 16, 0.88);
    box-shadow: 0 1px 0 rgba(255, 107, 0, 0.15),
                0 8px 40px rgba(0, 0, 0, 0.6),
                0 0 60px rgba(255, 107, 0, 0.03);
  }

  /* Línea decorativa inferior naranja difuminada */
  .header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(255, 107, 0, 0.3), transparent);
    pointer-events: none;
  }

  /* Barra de progreso de scroll */
  .scroll-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: var(--progress, 0%);
    background: linear-gradient(to right, var(--orange-dim), var(--orange-core), var(--orange-glow));
    box-shadow: 0 0 8px rgba(255, 107, 0, 0.6);
    transition: width 80ms linear;
    z-index: 10;
  }
  
  .header-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  /* ---- LOGO ---- */
  .logo {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    gap: 0;
    transition: filter var(--transition);
  }

  .logo:hover {
    filter: drop-shadow(0 0 12px rgba(255, 107, 0, 0.5));
  }

  .logo-bracket {
    color: var(--orange-core);
    transition: color var(--transition), text-shadow var(--transition);
  }

  .logo-name {
    color: var(--text-primary);
    padding: 0 0.15em;
    transition: color var(--transition);
  }

  .logo:hover .logo-bracket {
    color: var(--orange-glow);
    text-shadow: 0 0 16px rgba(255, 165, 0, 0.7);
  }

  .logo:hover .logo-name {
    background: linear-gradient(90deg, #fff 0%, var(--orange-bright) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  /* ---- NAV ---- */
  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .nav-link {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    position: relative;
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    transition: color var(--transition), background var(--transition);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 8px;
    background: transparent;
    transition: background var(--transition);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: calc(100% - 1.5rem);
    height: 2px;
    background: linear-gradient(to right, var(--orange-core), var(--orange-bright));
    border-radius: 1px;
    transition: transform var(--transition-bounce);
    transform-origin: center;
  }
  
  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 107, 0, 0.07);
  }

  .nav-link:hover::after {
    transform: translateX(-50%) scaleX(1);
  }

  .github-icon {
    width: 1rem;
    height: 1rem;
  }

  .nav-github {
    color: var(--orange-core);
    border: 1px solid rgba(255, 107, 0, 0.2);
    margin-left: 0.5rem;
  }

  .nav-github:hover {
    color: var(--text-primary);
    background: rgba(255, 107, 0, 0.12);
    border-color: rgba(255, 107, 0, 0.5);
    box-shadow: 0 0 16px rgba(255, 107, 0, 0.15);
  }

  .nav-github::after {
    display: none;
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 480px) {
    .logo-name {
      display: none;
    }
    .nav {
      gap: 0;
    }
    .nav-link {
      font-size: 0.82rem;
      padding: 0.4rem 0.6rem;
    }
  }
</style>

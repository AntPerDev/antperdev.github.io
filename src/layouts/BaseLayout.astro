---
import Header from "../components/Header.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "antperdev | Portfolio Profesional",
  description = "Portfolio profesional de antperdev, desarrollador de software especializado en aplicaciones robustas, código limpio e interfaces premium.",
  image = "/images/default-og.png",
} = Astro.props;

// Sanitizar cadenas para meta tags evitando inyecciones de HTML/XSS en el build
const sanitizeMeta = (str: string) => {
  return str
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
};

const safeTitle = sanitizeMeta(title);
const safeDescription = sanitizeMeta(description);
const safeImage = sanitizeMeta(image);
---

<!doctype html>
<html lang="es"></html>

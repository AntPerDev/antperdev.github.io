---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

// Obtener y ordenar proyectos por fecha descendente de forma estática en build-time
const projects = await getCollection("projects");
const sortedProjects = projects.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="antperdev | Desarrollador de Software & Arquitecto Web"
  description="Portfolio profesional de Antperdev, especializado en construir aplicaciones robustas, código limpio, SOLID y seguridad en el frontend."
>
  <!-- ============================================================
  HERO SECTION
  ============================================================ -->
  <section class="hero dot-grid" aria-label="Introducción" id="hero">
    <!-- Orbes de luz decorativas de fondo -->
    <!-- <div class="hero-orb hero-orb--orange" aria-hidden="true"></div>
    <div class="hero-orb hero-orb--violet" aria-hidden="true"></div>
    <div class="hero-orb hero-orb--blue" aria-hidden="true"></div> -->

    <!-- Partículas flotantes -->
    <!-- <div class="particles" aria-hidden="true">
      {
        Array.from({ length: 12 }).map((_, i) => (
          <span class={`particle particle-${i + 1}`} />
        ))
      }
    </div> -->

    <div class="hero-container">
      <!-- Avatar con múltiples anillos pulsantes y escáner -->
      <!-- <div class="avatar-wrapper" aria-hidden="true">
        <div class="avatar-ring avatar-ring--scan"></div>
        <div class="avatar-ring avatar-ring--1"></div>
        <div class="avatar-ring avatar-ring--2"></div>
        <div class="avatar-ring avatar-ring--3"></div>
        <div class="avatar">
          <span class="avatar-text">AP</span>
          <div class="avatar-shine"></div>
        </div>
      </div> -->

      <div class="hero-content animate-fade-in delay-1">
        <!-- Badge de disponibilidad con punto pulsante -->
        <div class="hero-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          DISPONIBLE PARA NUEVOS PROYECTOS
        </div>

        <!-- Nombre con efecto shimmer -->
        <h1 class="hero-name">
          <span class="hero-name-inner">antperdev</span>
        </h1>

        <!-- Rol con degradado -->
        <p class="hero-role">
          Desarrollador de apps que funcionan en el navegador de tú equipo
          informático.
          <span class="role-separator" aria-hidden="true">&</span>
          Especialista en Rendimiento
        </p>

        <p class="hero-bio">
          Construyo sitios web en los que la gente desde el navegador de su
          teléfono, su televisor inteligente, su ordenador, puede interactuar,
          comprar algo, reservar un viaje, buscar una oferta de empleo, o
          reservar una cita con su médico, entre otras muchas cosas. Diseño
          tanto la parte que se ve en pantalla —los botones, formularios, el
          diseño web "frontend"— como la parte de detrás que hace que todo
          funcione (desarrollo backend), como guardar los datos o confirmar una
          reserva. Mi ocupación se llama desarrollador de aplicaciones web,
          desarrollador web full-stack. También se puede ver en algunos sitios
          como Software engineer (versión en inglés, muy usada también en
          ofertas en español, sobre todo de empresas tech) ó Desarrollador de
          plataformas web.
        </p>

        <!-- Stats rápidas -->
        <div class="hero-stats" aria-label="Estadísticas del desarrollador">
          <div class="stat-item">
            <span class="stat-number">+40</span>
            <span class="stat-label">Proyectos</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number">TDD</span>
            <span class="stat-label">Metodología</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number">SOLID</span>
            <span class="stat-label">Principios</span>
          </div>
        </div>

        <div class="hero-actions">
          <a href="#proyectos" class="cta-button" id="hero-cta-projects">
            <span class="cta-glow" aria-hidden="true"></span>
            <span class="cta-content">
              EXPLORAR PROYECTOS
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                stroke="currentColor"
                class="cta-arrow"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
              </svg>
            </span>
          </a>

          <a
            href="https://github.com/antperdev"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-ghost"
            id="hero-cta-github"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="ghost-icon"
              aria-hidden="true"
            >
              <path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path>
            </svg>
            VER GITHUB
          </a>
        </div>
      </div>
    </div>

    <!-- Divisor inferior con gradiente -->
    <div class="hero-divider" aria-hidden="true"></div>
  </section>

  <!-- ============================================================
    SECCIÓN DE PROYECTOS
  ============================================================ -->
  <section
    class="projects-section"
    id="proyectos"
    aria-labelledby="projects-heading"
  >
    <!-- Orbe decorativa para la sección -->
    <!-- <div class="section-orb" aria-hidden="true"></div> -->

    <div class="section-container">
      <div class="section-header animate-fade-in">
        <!-- Etiqueta decorativa sobre el título -->
        <span class="section-eyebrow" aria-hidden="true">
          ◆ TRABAJO SELECTO ◆
        </span>

        <h2 id="projects-heading" class="section-title">
          Proyectos
          <span class="title-accent">Destacados</span>
        </h2>

        <p class="section-subtitle">
          Una muestra selecta de desarrollos donde aplico TDD, SOLID y diseño de
          alta fidelidad.
        </p>

        <!-- Línea decorativa bajo el subtítulo -->
        <div class="title-line" aria-hidden="true">
          <span class="line-dot"></span>
          <span class="line-body"></span>
          <span class="line-dot"></span>
        </div>
      </div>

      <!-- /* Recorre la carpeta de proyectos y renderiza los que NO ESTAN en draft */ -->

      <!-- {        sortedProjects.length === 0 ? (
          <div class="no-projects">
            <p>
              No se encontraron proyectos. ¡Añade tu primer markdown en{" "}
              <code>src/content/projects/</code>!
            </p>
          </div>
        ) : (
          <div class="projects-grid">
            {sortedProjects.map((project, index) => (
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                repo={project.data.repo}
                live={project.data.live}
                tech={project.data.tech}
                stars={project.data.stars}
                cover={project.data.cover}
                slug={project.id}
                classDelay={`delay-${(index % 6) + 1}`}
              />
            ))}
          </div>
        )
      }  -->
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
    HERO
 ============================================================ */
  .hero {
    position: relative;
    padding: 8rem 1.5rem 7rem;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 107, 0, 0.1);
  }

  /* Orbes de luz de fondo */
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-orb--orange {
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      rgba(255, 107, 0, 0.12),
      transparent 70%
    );
    top: -150px;
    left: 50%;
    transform: translateX(-50%);
    animation: orbPulse 8s ease-in-out infinite;
  }

  .hero-orb--violet {
    width: 400px;
    height: 400px;
    background: radial-gradient(
      circle,
      rgba(124, 58, 237, 0.08),
      transparent 70%
    );
    bottom: -100px;
    right: -100px;
    animation: orbPulse 10s ease-in-out infinite reverse;
  }

  .hero-orb--blue {
    width: 300px;
    height: 300px;
    background: radial-gradient(
      circle,
      rgba(6, 182, 212, 0.05),
      transparent 70%
    );
    top: 50%;
    left: -100px;
    animation: orbPulse 12s ease-in-out infinite 2s;
  }

  @keyframes orbPulse {
    0%,
    100% {
      transform: scale(1) translateX(var(--tx, 0));
      opacity: 0.7;
    }
    50% {
      transform: scale(1.15) translateX(var(--tx, 0));
      opacity: 1;
    }
  }

  /* Partículas flotantes */
  .particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--orange-core);
    opacity: 0;
    animation: particleFloat linear infinite;
  }

  /* Posiciones y tamaños variados para cada partícula */
  .particle-1 {
    left: 10%;
    top: 20%;
    width: 3px;
    height: 3px;
    animation-duration: 8s;
    animation-delay: 0s;
    opacity: 0.6;
  }
  .particle-2 {
    left: 25%;
    top: 70%;
    width: 5px;
    height: 5px;
    animation-duration: 11s;
    animation-delay: 1s;
    background: var(--orange-glow);
  }
  .particle-3 {
    left: 40%;
    top: 40%;
    width: 2px;
    height: 2px;
    animation-duration: 7s;
    animation-delay: 2s;
    background: #fff;
    opacity: 0.4;
  }
  .particle-4 {
    left: 60%;
    top: 15%;
    width: 4px;
    height: 4px;
    animation-duration: 9s;
    animation-delay: 0.5s;
  }
  .particle-5 {
    left: 75%;
    top: 60%;
    width: 3px;
    height: 3px;
    animation-duration: 12s;
    animation-delay: 3s;
    background: var(--accent-violet);
    opacity: 0.5;
  }
  .particle-6 {
    left: 85%;
    top: 30%;
    width: 5px;
    height: 5px;
    animation-duration: 10s;
    animation-delay: 1.5s;
  }
  .particle-7 {
    left: 15%;
    top: 80%;
    width: 2px;
    height: 2px;
    animation-duration: 6s;
    animation-delay: 0.8s;
    background: #fff;
    opacity: 0.3;
  }
  .particle-8 {
    left: 50%;
    top: 85%;
    width: 4px;
    height: 4px;
    animation-duration: 13s;
    animation-delay: 2.5s;
    background: var(--orange-bright);
  }
  .particle-9 {
    left: 90%;
    top: 50%;
    width: 3px;
    height: 3px;
    animation-duration: 8s;
    animation-delay: 4s;
  }
  .particle-10 {
    left: 5%;
    top: 50%;
    width: 2px;
    height: 2px;
    animation-duration: 9s;
    animation-delay: 1.2s;
    background: var(--accent-cyan);
    opacity: 0.5;
  }
  .particle-11 {
    left: 70%;
    top: 80%;
    width: 3px;
    height: 3px;
    animation-duration: 11s;
    animation-delay: 3.5s;
  }
  .particle-12 {
    left: 35%;
    top: 10%;
    width: 4px;
    height: 4px;
    animation-duration: 7s;
    animation-delay: 2s;
  }

  @keyframes particleFloat {
    0% {
      transform: translateY(0) scale(1);
      opacity: 0;
    }
    10% {
      opacity: 0.8;
    }
    90% {
      opacity: 0.4;
    }
    100% {
      transform: translateY(-120px) scale(0.5);
      opacity: 0;
    }
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 860px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2.5rem;
  }

  /* ---- AVATAR ---- */
  .avatar-wrapper {
    position: relative;
    width: 140px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .avatar {
    position: relative;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);
    border: 2px solid rgba(255, 107, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    box-shadow:
      0 0 0 1px rgba(255, 107, 0, 0.1),
      0 0 20px rgba(255, 107, 0, 0.25),
      0 0 60px rgba(255, 107, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    overflow: hidden;
    animation: floatY 4s ease-in-out infinite;
  }

  .avatar-shine {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(255, 107, 0, 0.08) 60deg,
      transparent 120deg
    );
    animation: borderSpin 6s linear infinite;
    pointer-events: none;
  }

  .avatar-text {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    user-select: none;
    background: linear-gradient(135deg, #ffffff 30%, var(--orange-bright) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    position: relative;
    z-index: 2;
  }

  /* Anillos concéntricos */
  .avatar-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .avatar-ring--1 {
    width: 125px;
    height: 125px;
    border: 1px solid rgba(255, 107, 0, 0.4);
    animation: ringPulse 2.5s ease-out infinite;
  }

  .avatar-ring--2 {
    width: 142px;
    height: 142px;
    border: 1px solid rgba(255, 107, 0, 0.2);
    animation: ringPulse 2.5s ease-out infinite 0.6s;
  }

  .avatar-ring--3 {
    width: 162px;
    height: 162px;
    border: 1px dashed rgba(255, 107, 0, 0.1);
    animation: avatarRotate 25s linear infinite;
  }

  .avatar-ring--scan {
    width: 126px;
    height: 126px;
    border: 2px solid transparent;
    background:
      linear-gradient(var(--bg-primary), var(--bg-primary)) padding-box,
      conic-gradient(from 0deg, var(--orange-core) 0deg, transparent 120deg)
        border-box;
    animation: borderSpin 3s linear infinite;
    z-index: 4;
  }

  @keyframes ringPulse {
    0% {
      transform: translate(-50%, -50%) scale(0.95);
      opacity: 0.7;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.25);
      opacity: 0;
    }
  }

  @keyframes avatarRotate {
    0% {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    100% {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @keyframes floatY {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  /* ---- HERO CONTENT ---- */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }

  /* Badge disponibilidad */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--orange-bright);
    background: rgba(255, 107, 0, 0.08);
    border: 1px solid rgba(255, 107, 0, 0.25);
    padding: 0.35rem 1rem;
    border-radius: 30px;
    letter-spacing: 0.12em;
    backdrop-filter: blur(8px);
    transition: box-shadow var(--transition);
  }

  .hero-badge:hover {
    box-shadow: 0 0 20px rgba(255, 107, 0, 0.2);
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: badgePulse 1.8s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes badgePulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    50% {
      box-shadow: 0 0 0 5px rgba(34, 197, 94, 0);
    }
  }

  /* Nombre con shimmer */
  .hero-name {
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    letter-spacing: 0.03em;
    line-height: 1;
    margin: 0;
    position: relative;
  }

  .hero-name-inner {
    display: inline-block;
    background: linear-gradient(
      90deg,
      #ffffff 0%,
      #ffffff 30%,
      var(--orange-bright) 50%,
      #ffffff 70%,
      #ffffff 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 5s linear infinite;
  }

  .hero-role {
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--text-secondary);
    max-width: 580px;
    line-height: 1.5;
  }

  .role-separator {
    color: var(--orange-core);
    font-weight: 700;
    padding: 0 0.3em;
  }

  .hero-bio {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 640px;
    line-height: 1.75;
  }

  /* Stats rápidas */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 0;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 0.85rem 1.5rem;
    backdrop-filter: blur(12px);
    margin-top: 0.25rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0 1.5rem;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--orange-bright);
    line-height: 1;
    letter-spacing: 0.05em;
    text-shadow: 0 0 20px rgba(255, 140, 0, 0.5);
  }

  .stat-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(255, 255, 255, 0.1),
      transparent
    );
    flex-shrink: 0;
  }

  /* ---- CTA BUTTONS ---- */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 1rem;
  }

  .cta-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    border-radius: 10px;
    overflow: hidden;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      transform var(--transition-bounce),
      box-shadow var(--transition);
  }

  /* Fondo gradiente animado del CTA principal */
  .cta-button::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      var(--orange-dim) 0%,
      var(--orange-core) 40%,
      var(--orange-bright) 70%,
      var(--orange-glow) 100%
    );
    background-size: 200% 200%;
    animation: gradientShift 4s ease infinite;
    z-index: 0;
  }

  @keyframes gradientShift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .cta-glow {
    position: absolute;
    inset: -2px;
    border-radius: 12px;
    background: inherit;
    filter: blur(12px);
    opacity: 0;
    z-index: -1;
    transition: opacity var(--transition);
  }

  .cta-button:hover .cta-glow {
    opacity: 0.6;
  }

  .cta-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 2.2rem;
  }

  .cta-button:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow:
      0 0 30px rgba(255, 107, 0, 0.5),
      0 8px 24px rgba(255, 107, 0, 0.3);
  }

  .cta-button:active {
    transform: scale(0.97);
  }

  .cta-arrow {
    width: 1.1rem;
    height: 1.1rem;
    animation: bounceDown 1.8s ease-in-out infinite;
  }

  @keyframes bounceDown {
    0%,
    100% {
      transform: translateY(-2px);
    }
    50% {
      transform: translateY(4px);
    }
  }

  /* Botón fantasma */
  .cta-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 0.9rem 2rem;
    letter-spacing: 0.06em;

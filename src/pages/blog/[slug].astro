---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Generar rutas estáticas estáticamente en build-time
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Ordenar por fecha descendente
  const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  
  return sortedPosts.map((post, index) => {
    const prev = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;
    const next = index > 0 ? sortedPosts[index - 1] : null;
    
    return {
      params: { slug: post.slug },
      props: { post, prev, next },
    };
  });
}

const { post, prev, next } = Astro.props;
const { Content } = await post.render();

// Formatear la fecha en español de forma elegante
const formattedDate = post.data.date.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout 
  title={`${post.data.title} | Blog antperdev`}
  description={post.data.description}
  image={post.data.cover}
>
  <section class="blog-hero">
    <!-- Orbes de luz decorativas -->
    <div class="phero-orb phero-orb--main" aria-hidden="true"></div>
    <div class="phero-orb phero-orb--secondary" aria-hidden="true"></div>
    <div class="phero-grid-overlay" aria-hidden="true"></div>

    <div class="hero-container">
      <!-- Enlace de retorno con animación -->
      <a href="/blog" class="back-link" id="blog-back-link" aria-label="Volver a la lista de artículos">
        <span class="back-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
        </span>
        VOLVER AL BLOG
      </a>

      <!-- Categoría o Metadata superior -->
      <div class="post-meta-top">
        <span class="post-date">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="calendar-icon" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          Publicado el {formattedDate}
        </span>
      </div>

      <!-- Título de la entrada -->
      <h1 class="post-title">{post.data.title}</h1>

      <!-- Barra separadora animada -->
      <div class="title-separator" aria-hidden="true">
        <span class="separator-line"></span>
        <span class="separator-diamond">◆</span>
        <span class="separator-line"></span>
      </div>

      <!-- Resumen descriptivo -->
      <p class="post-summary">{post.data.description}</p>

      <!-- Tags en el Hero -->
      <div class="post-tags" aria-label="Temas de esta entrada">
        {post.data.tags.map((tag) => (
          <span class="tag-item">#{tag}</span>
        ))}
      </div>
    </div>
    
    <div class="hero-bottom-line" aria-hidden="true"></div>
  </section>

  <div class="blog-detail-body">
    <div class="detail-container">
      
      <!-- Contenido renderizado con clase prose del diseño global -->
      <article class="prose-content prose" id="blog-markdown-content">
        <Content />
      </article>

      <hr class="separator" />

      <!-- Navegación inferior: artículo anterior / siguiente -->
      <nav class="post-navigation" aria-label="Navegación del blog">
        <div class="nav-item prev-item">
          {prev && (
            <a href={`/blog/${prev.slug}`} class="nav-nav-link prev" aria-label={`Ir al artículo anterior: ${prev.data.title}`}>
              <span class="nav-meta">← POST ANTERIOR</span>
              <span class="nav-title">{prev.data.title}</span>
            </a>
          )}
        </div>
        
        <div class="nav-item next-item">
          {next && (
            <a href={`/blog/${next.slug}`} class="nav-nav-link next" aria-label={`Ir al artículo siguiente: ${next.data.title}`}>
              <span class="nav-meta">POST SIGUIENTE →</span>
              <span class="nav-title">{next.data.title}</span>
            </a>
          )}
        </div>
      </nav>

    </div>
  </div>
</BaseLayout>

<style>
  /* ============================================================
     HERO DEL DETALLE DE POST
     ============================================================ */
  .blog-hero {
    position: relative;
    padding: 5.5rem 1.5rem 4.5rem;
    background: linear-gradient(180deg, rgba(14, 14, 26, 0.95) 0%, rgba(8, 8, 16, 0.8) 100%);
    border-bottom: 1px solid rgba(255, 107, 0, 0.12);
    overflow: hidden;
  }

  /* Orbes */
  .phero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .phero-orb--main {
    width: 600px;
    height: 450px;
    background: radial-gradient(ellipse, rgba(124, 58, 237, 0.07) 0%, transparent 70%);
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    animation: orbMove 12s ease-in-out infinite;
  }

  .phero-orb--secondary {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(255, 107, 0, 0.05) 0%, transparent 70%);
    bottom: -80px;
    right: 5%;
  }

  @keyframes orbMove {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-45%) translateY(15px); }
  }

  .phero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 107, 0, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 107, 0, 0.02) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
    z-index: 0;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.05));
  }

  .hero-container {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ---- BACK LINK ---- */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
    transition: color var(--transition), gap var(--transition-bounce);
  }

  .back-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    transition: border-color var(--transition), background var(--transition), transform var(--transition-bounce);
  }

  .back-link:hover {
    color: var(--orange-core);
    gap: 0.75rem;
  }

  .back-link:hover .back-icon {
    border-color: rgba(255, 107, 0, 0.4);
    background: rgba(255, 107, 0, 0.08);
    transform: translateX(-3px);
  }

  /* ---- METADATA ---- */
  .post-meta-top {
    margin-bottom: 0.75rem;
  }

  .post-date {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--orange-bright);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .calendar-icon {
    width: 0.95rem;
    height: 0.95rem;
  }

  /* ---- TÍTULO ---- */
  .post-title {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    margin-bottom: 1.25rem;
    background: linear-gradient(135deg, #ffffff 40%, var(--orange-bright) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
  }

  /* ---- SEPARADOR ---- */
  .title-separator {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    width: 100%;
    justify-content: center;
  }

  .separator-line {
    flex: 1;
    max-width: 80px;
    height: 1px;
    background: linear-gradient(to right, rgba(255, 107, 0, 0.5), rgba(255, 107, 0, 0.1));
  }

  .separator-line:last-child {
    background: linear-gradient(to left, rgba(255, 107, 0, 0.5), rgba(255, 107, 0, 0.1));
  }

  .separator-diamond {
    font-size: 0.6rem;
    color: var(--orange-core);
    text-shadow: 0 0 5px rgba(255, 107, 0, 0.6);
  }

  /* ---- SUMMARY ---- */
  .post-summary {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 700px;
  }

  /* ---- TAGS ---- */
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .tag-item {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    transition: color var(--transition), border-color var(--transition);
  }

  .tag-item:hover {
    color: var(--orange-bright);
    border-color: rgba(255, 107, 0, 0.3);
  }

  .hero-bottom-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(255, 107, 0, 0.4), transparent);
  }

  /* ============================================================
     CUERPO DEL POST
     ============================================================ */
  .blog-detail-body {
    padding: 4rem 1.5rem;
    background-color: var(--bg-primary);
  }

  .detail-container {
    max-width: 780px;
    margin: 0 auto;
  }

  /* Adaptación de iframes embebidos (ej. videos de YouTube) */
  .prose-content :global(.embed-container) {
    position: relative;
    padding-bottom: 56.25%; /* Relación 16:9 */
    height: 0;
    overflow: hidden;
    max-width: 100%;
    margin-bottom: 2rem;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    border: 1px solid var(--border);
  }

  .prose-content :global(.embed-container iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .prose-content {
    margin-bottom: 5rem;
  }

  .separator {
    border: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--border), transparent);
    margin-bottom: 3.5rem;
  }

  /* ============================================================
     NAVEGACIÓN EN POSTS
     ============================================================ */
  .post-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .nav-item {
    display: flex;
    flex-direction: column;
  }

  .nav-item.next-item {
    align-items: flex-end;
    text-align: right;
  }

  .nav-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 1.4rem;
    background: linear-gradient(135deg, rgba(20, 20, 35, 0.7), rgba(12, 12, 22, 0.8));
    border: 1px solid var(--border);
    border-radius: 12px;
    width: 100%;
    transition: transform var(--transition), border-color var(--transition), background-color var(--transition), box-shadow var(--transition);
  }

  .nav-nav-link:hover {
    border-color: rgba(255, 107, 0, 0.4);
    background-color: rgba(255, 107, 0, 0.03);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .nav-nav-link.prev:hover {
    transform: translateX(-4px);
  }

  .nav-nav-link.next:hover {
    transform: translateX(4px);
  }

  .nav-meta {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--orange-core);
    letter-spacing: 0.08em;
  }

  .nav-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 640px) {
    .post-navigation {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    
    .nav-item.next-item {
      align-items: flex-start;
      text-align: left;
    }

    .post-title {
      font-size: 2.2rem;
    }
  }
</style>
